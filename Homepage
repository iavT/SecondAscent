<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>The Second Ascent — Private Rite of Passage</title>
  <meta name="description" content="The Second Ascent: a private, selective, consequential rite of passage for men entering the second half of life. 10–12 men. Application required. Seasonal progression. Annual expedition." />
  <style>
    :root{
      --bg:#0b0f14;
      --panel:#0f1620;
      --text:#e7edf5;
      --muted:#b7c3d4;
      --subtle:#7e8ba1;
      --line:rgba(231,237,245,.10);
      --accent:#e7edf5; /* keep monochrome: elite, no hype */
      --shadow: 0 20px 80px rgba(0,0,0,.45);
      --radius: 18px;
      --max: 1100px;
    }
    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0;
      font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, "Apple Color Emoji","Segoe UI Emoji";
      background: radial-gradient(1200px 700px at 50% -20%, rgba(231,237,245,.10), transparent 60%) , var(--bg);
      color:var(--text);
      line-height:1.55;
      letter-spacing:.2px;
    }
    a{color:inherit; text-decoration:none}
    .wrap{max-width:var(--max); margin:0 auto; padding:0 22px}
    .nav{
      position:sticky; top:0; z-index:50;
      backdrop-filter: blur(10px);
      background: rgba(11,15,20,.72);
      border-bottom:1px solid var(--line);
    }
    .nav-inner{
      display:flex; align-items:center; justify-content:space-between;
      height:68px;
    }
    .brand{
      display:flex; align-items:center; gap:10px; font-weight:700;
      letter-spacing:.6px; text-transform:uppercase; font-size:12px;
      color:var(--muted);
    }
    .dot{width:8px;height:8px;border-radius:999px;background:rgba(231,237,245,.85)}
    .nav-links{display:flex; gap:16px; align-items:center}
    .nav-links a{
      font-size:13px; color:var(--muted);
      padding:8px 10px; border-radius:12px;
    }
    .nav-links a:hover{background:rgba(231,237,245,.06); color:var(--text)}
    .btn{
      display:inline-flex; align-items:center; justify-content:center;
      padding:12px 16px; border-radius:14px;
      border:1px solid rgba(231,237,245,.22);
      background:rgba(231,237,245,.06);
      color:var(--text);
      font-weight:600;
      transition: transform .08s ease, background .12s ease, border-color .12s ease;
      cursor:pointer;
    }
    .btn:hover{background:rgba(231,237,245,.10); border-color:rgba(231,237,245,.34)}
    .btn:active{transform: translateY(1px)}
    .btn.primary{
      background:rgba(231,237,245,.14);
      border-color:rgba(231,237,245,.45);
    }
    .btn.primary:hover{background:rgba(231,237,245,.18)}
    .hero{padding:70px 0 38px}
    .hero-grid{
      display:grid; grid-template-columns: 1.2fr .8fr; gap:28px;
      align-items:start;
    }
    @media (max-width: 920px){
      .hero-grid{grid-template-columns:1fr; gap:18px}
      .nav-links{display:none}
    }
    .kicker{
      color:var(--muted); font-weight:700; letter-spacing:.8px;
      text-transform:uppercase; font-size:12px;
    }
    h1{
      margin:12px 0 14px;
      font-size:54px;
      letter-spacing:-.8px;
      line-height:1.06;
    }
    @media (max-width: 520px){ h1{font-size:40px} }
    .lead{
      color:var(--muted);
      font-size:18px;
      max-width: 58ch;
    }
    .hero-cta{display:flex; gap:12px; flex-wrap:wrap; margin-top:22px}
    .card{
      background: linear-gradient(180deg, rgba(231,237,245,.06), rgba(231,237,245,.03));
      border:1px solid var(--line);
      border-radius:var(--radius);
      box-shadow: var(--shadow);
    }
    .card.pad{padding:18px}
    .mini{
      color:var(--subtle);
      font-size:13px;
    }
    .statgrid{
      display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-top:12px;
    }
    .stat{
      border:1px solid var(--line);
      border-radius:14px;
      padding:12px;
      background: rgba(11,15,20,.35);
    }
    .stat b{display:block; font-size:14px; color:var(--text)}
    .stat span{display:block; font-size:12px; color:var(--subtle); margin-top:4px}
    section{padding:40px 0}
    .section-title{
      font-size:22px; margin:0 0 10px; letter-spacing:-.2px;
    }
    .section-sub{
      margin:0 0 18px;
      color:var(--muted);
      max-width: 80ch;
    }
    .grid2{display:grid; grid-template-columns:1fr 1fr; gap:16px}
    @media (max-width: 840px){ .grid2{grid-template-columns:1fr} }
    .panel{
      padding:18px;
      border-radius:var(--radius);
      border:1px solid var(--line);
      background: rgba(15,22,32,.55);
    }
    .panel h3{margin:0 0 8px; font-size:16px}
    .panel p{margin:0; color:var(--muted); font-size:14px}
    .pillars{display:grid; grid-template-columns:repeat(4,1fr); gap:10px}
    @media (max-width: 840px){ .pillars{grid-template-columns:1fr 1fr} }
    @media (max-width: 520px){ .pillars{grid-template-columns:1fr} }
    .pillar{
      padding:14px;
      border-radius:16px;
      border:1px solid var(--line);
      background: rgba(11,15,20,.35);
    }
    .pillar b{display:block; font-size:14px}
    .pillar span{display:block; margin-top:6px; color:var(--muted); font-size:13px}
    .list{margin:0; padding-left:18px; color:var(--muted)}
    .list li{margin:6px 0}
    .seasons{display:grid; grid-template-columns:1fr 1fr; gap:12px}
    @media (max-width: 840px){ .seasons{grid-template-columns:1fr} }
    .season{
      padding:16px;
      border-radius:16px;
      border:1px solid var(--line);
      background: rgba(11,15,20,.35);
    }
    .season h3{margin:0 0 6px; font-size:15px}
    .season p{margin:0 0 10px; color:var(--muted); font-size:13px}
    .req{margin:0; padding-left:18px; color:var(--muted); font-size:13px}
    .req li{margin:5px 0}
    .ranks{display:grid; grid-template-columns:repeat(4,1fr); gap:10px}
    @media (max-width: 980px){ .ranks{grid-template-columns:1fr 1fr} }
    @media (max-width: 520px){ .ranks{grid-template-columns:1fr} }
    .rank{
      padding:14px;
      border-radius:16px;
      border:1px solid var(--line);
      background: rgba(11,15,20,.35);
    }
    .rank b{display:block; font-size:14px}
    .rank span{display:block; margin-top:6px; color:var(--muted); font-size:13px}
    .divider{border-top:1px solid var(--line); margin:0}
    .cta{
      padding:28px;
      border-radius:var(--radius);
      border:1px solid rgba(231,237,245,.16);
      background: linear-gradient(180deg, rgba(231,237,245,.08), rgba(231,237,245,.03));
      box-shadow: var(--shadow);
    }
    .cta h2{margin:0 0 10px; font-size:22px}
    .cta p{margin:0 0 18px; color:var(--muted)}
    form{display:grid; grid-template-columns:1fr 1fr; gap:12px}
    @media (max-width: 760px){ form{grid-template-columns:1fr} }
    label{display:block; font-size:12px; color:var(--subtle); margin-bottom:6px}
    input, textarea, select{
      width:100%;
      border-radius:14px;
      border:1px solid rgba(231,237,245,.14);
      background: rgba(11,15,20,.55);
      color:var(--text);
      padding:12px 12px;
      outline:none;
    }
    textarea{min-height:110px; resize:vertical}
    .full{grid-column:1 / -1}
    .fine{
      color:var(--subtle);
      font-size:12px;
      margin-top:10px;
    }
    footer{
      padding:34px 0 60px;
      color:var(--subtle);
      font-size:12px;
    }
    .toast{
      position:fixed; right:18px; bottom:18px;
      background: rgba(15,22,32,.92);
      border:1px solid rgba(231,237,245,.14);
      color:var(--text);
      padding:12px 14px;
      border-radius:14px;
      box-shadow: var(--shadow);
      display:none;
      max-width: 360px;
      z-index:100;
    }
  </style>
</head>
<body>

  <div class="nav">
    <div class="wrap nav-inner">
      <div class="brand"><span class="dot"></span> THE SECOND ASCENT</div>
      <div class="nav-links">
        <a href="#plateau">The Plateau</a>
        <a href="#concept">Concept</a>
        <a href="#structure">Structure</a>
        <a href="#seasons">Seasons</a>
        <a href="#apply">Apply</a>
      </div>
      <a class="btn primary" href="#apply">Request Conversation</a>
    </div>
  </div>

  <header class="hero">
    <div class="wrap hero-grid">
      <div>
        <div class="kicker">Private · Selective · Consequential</div>
        <h1>The Second Ascent</h1>
        <p class="lead">
          A controlled rite of passage for men entering the second half of life.
          Not therapy. Not ideology. Not a networking circle.
          A seasonal system that reintroduces consequence—physical, relational, existential—so force returns.
        </p>
        <div class="hero-cta">
          <a class="btn primary" href="#apply">Request Conversation</a>
          <a class="btn" href="#structure">See the Structure</a>
        </div>
        <p class="mini" style="margin-top:14px">
          Cohort size: 10–12. Application and interview required. Annual expedition mandatory.
        </p>
      </div>

      <aside class="card pad" aria-label="Key facts">
        <div class="mini">A mirror, not a pitch.</div>
        <p style="margin:10px 0 0; color:var(--muted); font-size:14px">
          You have built stability. If something has thinned—energy, edge, depth, brotherhood—this is the threshold.
          Comfort is rarely obvious. It accumulates.
        </p>
        <div class="statgrid">
          <div class="stat"><b>10–12 men</b><span>Small by design</span></div>
          <div class="stat"><b>4 seasons / year</b><span>12-week cycles</span></div>
          <div class="stat"><b>Weekly council</b><span>90 minutes</span></div>
          <div class="stat"><b>Annual expedition</b><span>Mandatory hardship</span></div>
        </div>
      </aside>
    </div>
  </header>

  <hr class="divider"/>

  <main>
    <section id="plateau">
      <div class="wrap">
        <h2 class="section-title">The Quiet Plateau</h2>
        <p class="section-sub">
          Nothing is broken. And yet: training becomes maintenance. Conversations become efficient. Risk narrows.
          Conflict is managed, not mastered. The future feels less defined than the past.
          This is not crisis. It’s plateau.
        </p>

        <div class="grid2">
          <div class="panel">
            <h3>The real problem</h3>
            <p>
              Modern men are initiated into adulthood, but rarely re-initiated into midlife.
              When the first mission dissolves (children grow, career stabilizes), the absence of consequence creates drift—
              incremental, polite, invisible.
            </p>
          </div>
          <div class="panel">
            <h3>The purpose</h3>
            <p>
              Reintroduce controlled consequence—physical, relational, existential—so force returns.
              Not chaos. Not regression. Not ideology.
              Consequence.
            </p>
          </div>
        </div>
      </div>
    </section>

    <section id="concept">
      <div class="wrap">
        <h2 class="section-title">What This Is</h2>
        <p class="section-sub">
          A private, seasonal, rank-based arena. Small cohort. Standards enforced. Progress earned.
        </p>

        <div class="pillars" aria-label="Four pillars">
          <div class="pillar"><b>Body</b><span>Measured strain restores vitality and embodied authority.</span></div>
          <div class="pillar"><b>Courage</b><span>Avoided actions executed. Agency replaces avoidance.</span></div>
          <div class="pillar"><b>Depth</b><span>Direct feedback, repair, clean confrontation. No performance.</span></div>
          <div class="pillar"><b>Contribution</b><span>Leadership beyond self. Brotherhood is earned.</span></div>
        </div>
      </div>
    </section>

    <section id="structure">
      <div class="wrap">
        <h2 class="section-title">The Structure</h2>
        <p class="section-sub">
          Minimal bureaucracy. Maximum consequence. You don’t join to “participate.” You enter to be sharpened.
        </p>

        <div class="grid2">
          <div class="panel">
            <h3>Weekly Council (90 minutes)</h3>
            <p>Structured arena: one man in the hot seat, direct feedback, clear commitments declared publicly.</p>
          </div>
          <div class="panel">
            <h3>Weekly Standards</h3>
            <p>Minimum two measurable training sessions + one avoided action executed (conversation, boundary, decision).</p>
          </div>
          <div class="panel">
            <h3>Monthly Forge (4 hours, in person)</h3>
            <p>Shared stress (physical or psychological). Bonding under load. This is where depth accelerates.</p>
          </div>
          <div class="panel">
            <h3>Annual Expedition (mandatory)</h3>
            <p>Multi-day controlled hardship. Fatigue, navigation, team stress. This becomes the spine of the system.</p>
          </div>
        </div>

        <div class="panel" style="margin-top:16px">
          <h3>What you will do (not exhaustive)</h3>
          <ul class="list">
            <li>Train under measurable load each week.</li>
            <li>Execute hard conversations and boundaries.</li>
            <li>Receive direct feedback—without insulation.</li>
            <li>Complete at least one formal repair annually.</li>
            <li>Write and live by a personal code.</li>
            <li>Confront mortality and redesign the next decade.</li>
          </ul>
          <p class="mini" style="margin-top:10px">
            Optional survival workshops exist as add-ons (navigation, first aid, bushcraft). They accelerate competence, but they are not required.
          </p>
        </div>
      </div>
    </section>

    <section id="seasons">
      <div class="wrap">
        <h2 class="section-title">The Seasonal Arc</h2>
        <p class="section-sub">
          Four 12-week seasons. Stimulus changes. Standards remain. Each season ends with visible movement—or it did not work.
        </p>

        <div class="seasons">
          <div class="season">
            <h3>Spring — Reawaken</h3>
            <p>Rebuild outward energy and social courage.</p>
            <ul class="req">
              <li>20+ physical sessions</li>
              <li>3 reconnections</li>
              <li>1 hosted gathering</li>
              <li>1 avoided conversation executed</li>
            </ul>
          </div>
          <div class="season">
            <h3>Summer — Confront</h3>
            <p>Strength, boundaries, embodied authority.</p>
            <ul class="req">
              <li>10 measurable strength sessions</li>
              <li>2 boundaries enforced</li>
              <li>1 confrontation handled cleanly</li>
              <li>Lead one council segment</li>
            </ul>
          </div>
          <div class="season">
            <h3>Autumn — Integrate</h3>
            <p>Repair, responsibility, consolidation.</p>
            <ul class="req">
              <li>1 formal repair</li>
              <li>Written personal code</li>
              <li>360 feedback (peers + family)</li>
            </ul>
          </div>
          <div class="season">
            <h3>Winter — Redesign</h3>
            <p>Mortality, clarity, strategy for the next decade.</p>
            <ul class="req">
              <li>3-hour solo walk</li>
              <li>Legacy letter draft</li>
              <li>12-month strategy document</li>
              <li>Public declaration</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <section id="ranks">
      <div class="wrap">
        <h2 class="section-title">Rank Progression</h2>
        <p class="section-sub">
          Advancement is not automatic. It is earned and voted by the council. Attendance does not equal progress.
        </p>

        <div class="ranks">
          <div class="rank">
            <b>Initiate</b>
            <span>Complete one full season without avoidance. Meet physical + courage standards.</span>
          </div>
          <div class="rank">
            <b>Builder</b>
            <span>Demonstrate one irreversible life shift. Lead a Forge.</span>
          </div>
          <div class="rank">
            <b>Guardian</b>
            <span>Mentor a new member. Demonstrate impact beyond self.</span>
          </div>
          <div class="rank">
            <b>Elder</b>
            <span>Invitation only. Proven stabilizer and net contributor across years.</span>
          </div>
        </div>

        <div class="panel" style="margin-top:16px">
          <h3>Standards & Consequence</h3>
          <p>
            Missed commitments are addressed directly. Repeated disengagement triggers review.
            Confidentiality is non-negotiable. Entry and exit are deliberate.
            This is chosen carefully.
          </p>
        </div>
      </div>
    </section>

    <section id="apply">
      <div class="wrap">
        <div class="cta">
          <h2>Request a Private Conversation</h2>
          <p>
            This is not open enrollment. If you are prepared for structured challenge rather than affirmation,
            submit a request. You will receive next steps if there is fit.
          </p>

          <!-- Note: this form is front-end only. Connect it to your backend (or a service) to send emails. -->
          <form id="appForm">
            <div>
              <label for="name">Full name</label>
              <input id="name" name="name" type="text" autocomplete="name" required />
            </div>
            <div>
              <label for="email">Email</label>
              <input id="email" name="email" type="email" autocomplete="email" required />
            </div>
            <div>
              <label for="location">City / Country</label>
              <input id="location" name="location" type="text" autocomplete="address-level2" />
            </div>
            <div>
              <label for="referral">Referral (optional)</label>
              <input id="referral" name="referral" type="text" placeholder="Name of referrer, if any" />
            </div>
            <div class="full">
              <label for="reason">Why now? (3–6 sentences)</label>
              <textarea id="reason" name="reason" required></textarea>
            </div>
            <div class="full">
              <label for="edge">What are you avoiding that you suspect is costing you force?</label>
              <textarea id="edge" name="edge" required></textarea>
            </div>
            <div>
              <label for="availability">Availability</label>
              <select id="availability" name="availability" required>
                <option value="" disabled selected>Select</option>
                <option>Weekly council + monthly forge (committed)</option>
                <option>Weekly council only (not sufficient)</option>
                <option>Unsure (likely not a fit)</option>
              </select>
            </div>
            <div>
              <label for="start">Preferred start</label>
              <select id="start" name="start" required>
                <option value="" disabled selected>Select</option>
                <option>Next season</option>
                <option>Following season</option>
                <option>Open to timing</option>
              </select>
            </div>
            <div class="full" style="display:flex; gap:12px; flex-wrap:wrap; align-items:center">
              <button class="btn primary" type="submit">Submit Request</button>
              <a class="btn" href="#plateau">Re-read the threshold</a>
            </div>
          </form>

          <p class="fine">
            Note: The form above is a front-end template. Connect it to your email/CRM (e.g., Webflow forms, Netlify Forms, Formspree, Airtable, HubSpot, or a custom endpoint).
          </p>
        </div>

        <footer>
          <div class="wrap" style="padding:0">
            <div style="display:flex; justify-content:space-between; gap:12px; flex-wrap:wrap; border-top:1px solid var(--line); padding-top:18px;">
              <div>© <span id="year"></span> The Second Ascent</div>
              <div style="display:flex; gap:14px;">
                <a href="#concept">Concept</a>
                <a href="#structure">Structure</a>
                <a href="#apply">Apply</a>
              </div>
            </div>
            <div style="margin-top:10px; color:var(--subtle)">
              This is not therapy or medical advice. Participation requires personal responsibility and fitness appropriate to the demands of the program.
            </div>
          </div>
        </footer>
      </div>
    </section>
  </main>

  <div class="toast" id="toast" role="status" aria-live="polite"></div>

  <script>
    // Cosmetic year
    document.getElementById('year').textContent = new Date().getFullYear();

    // Front-end only submission (shows a toast and prints a payload to console).
    // Replace with a real submit handler when you connect a backend.
    const form = document.getElementById('appForm');
    const toast = document.getElementById('toast');

    function showToast(msg){
      toast.textContent = msg;
      toast.style.display = 'block';
      clearTimeout(window.__t);
      window.__t = setTimeout(()=> toast.style.display='none', 3800);
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();

      const data = Object.fromEntries(new FormData(form).entries());
      console.log("Application payload:", data);

      showToast("Request received (template). Connect this form to your email/CRM to process applications.");

      form.reset();
    });
  </script>
</body>
</html>
